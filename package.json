{
  "name": "guardia-incident-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador cooperativo de incidentes con backend autoritativo y SQLite persistente.",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --experimental-sqlite server.mjs",
    "dev": "node --experimental-sqlite --watch server.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "vite build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "preview:cloud": "wrangler dev",
    "test:browser": "python tests/browser.py"
  },
  "devDependencies": { "vite": "^7.3.2", "wrangler": "^4.65.0" }
}
